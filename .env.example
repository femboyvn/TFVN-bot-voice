# Copy to .env and fill in secrets. Never commit .env.
#   cp .env.example .env

# Required: create a bot token at https://discord.com/developers/applications
DISCORD_TOKEN=replace-with-your-bot-token

# Optional runtime tuning
COMMAND_PREFIX="!tfd "
LOG_LEVEL=INFO
DEFAULT_VOLUME=0.7
VOICE_CONNECT_TIMEOUT=20
VOICE_CONNECT_RETRIES=3
PLAYER_IDLE_TIMEOUT=300

# TTS (default Vietnamese via gTTS; requires network)
TTS_ENABLED=true
TTS_LANG=vi
# Music volume (0.0–1.0) while chat TTS is spoken over a playing track
MUSIC_DUCK_LEVEL=0.2

# Optional Spotify catalog lookup (https://developer.spotify.com/dashboard)
# Leave both empty, or set both. Track links still work without this
# (oEmbed). Albums, playlists, and artist links need both values.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Custom soundboard (per-server JSON + mp3 clips)
# Local/dev default. Docker Compose sets this to /data/soundboard on a volume.
SOUNDBOARD_DATA_DIR=data/soundboard
SOUNDBOARD_MAX_SECONDS=12
SOUNDBOARD_MAX_SOUNDS=40
SOUNDBOARD_MAX_BYTES=1500000
# Local play-cache TTL when R2 is enabled. Unused MP3s are deleted after this
# many days and re-downloaded on the next play. 0 keeps cache forever.
SOUNDBOARD_CACHE_DAYS=7

# Optional Cloudflare R2 (S3 API). Leave these empty for local-only storage.
# When all required R2 fields are set, R2 is the source of truth and the data
# dir is only a play cache. Required together: R2_BUCKET, R2_ACCESS_KEY_ID,
# R2_SECRET_ACCESS_KEY, and R2_ACCOUNT_ID or R2_ENDPOINT.
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PREFIX=soundboard
