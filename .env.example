# Required: create a bot token at https://discord.com/developers/applications
DISCORD_TOKEN=replace-with-your-bot-token

# Optional runtime tuning
COMMAND_PREFIX="!tfd "
LOG_LEVEL=INFO
DEFAULT_VOLUME=0.7
VOICE_CONNECT_TIMEOUT=20
VOICE_CONNECT_RETRIES=3
PLAYER_IDLE_TIMEOUT=300

# TTS (default Vietnamese via gTTS; requires network)
TTS_ENABLED=true
TTS_LANG=vi
# Music volume (0.0–1.0) while chat TTS is spoken over a playing track
MUSIC_DUCK_LEVEL=0.2

# Optional Spotify catalog lookup (https://developer.spotify.com/dashboard)
# Leave both empty, or set both. Track links still work without this
# (oEmbed). Albums, playlists, and artist links need both values.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
